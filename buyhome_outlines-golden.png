/* ============================================================
   CorretoraFlor — Sistema de design
   Preto fosco · Dourado metálico · Branco · Glassmorphism leve
   ============================================================ */

:root{
  /* Cores */
  --noir:      #0b0b0d;
  --noir-2:    #101013;
  --noir-3:    #16161a;
  --card:      #17171b;
  --ivory:     #f4f1ea;
  --muted:     #9b968c;
  --muted-2:   #6f6b63;
  --silver:    #e7e6e3;

  --gold:      #c9a24b;
  --gold-soft: #d9bd7a;
  --gold-deep: #9c7322;
  --gold-grad: linear-gradient(135deg,#f0d894 0%,#c9a24b 48%,#9c7322 100%);
  --gold-line: linear-gradient(90deg,transparent,rgba(201,162,75,.55),transparent);

  --line:      rgba(201,162,75,.20);
  --line-soft: rgba(255,255,255,.07);

  --glass:     rgba(255,255,255,.045);
  --glass-brd: rgba(255,255,255,.10);

  /* Tipografia */
  --serif: "Cormorant Garamond", Georgia, serif;
  --sans:  "Inter", system-ui, sans-serif;
  --util:  "Jost", "Inter", sans-serif;

  --radius:    20px;
  --radius-sm: 14px;
  --maxw:      1180px;
  --ease:      cubic-bezier(.22,.61,.36,1);
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--noir);
  color:var(--ivory);
  font-family:var(--sans);
  font-weight:300;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
ul{list-style:none}

.container{width:100%;max-width:var(--maxw);margin:0 auto;padding:0 24px}
.section{padding:clamp(64px,9vw,128px) 0}
section[id]{scroll-margin-top:88px}

/* ---- Tipografia utilitária ---- */
.eyebrow{
  font-family:var(--util);
  text-transform:uppercase;
  letter-spacing:.34em;
  font-size:.72rem;
  color:var(--gold);
  font-weight:400;
  margin-bottom:18px;
}
.section-title{
  font-family:var(--serif);
  font-weight:500;
  font-size:clamp(2rem,4.4vw,3.3rem);
  line-height:1.08;
  letter-spacing:.2px;
  color:var(--ivory);
}
.gold-text{
  font-style:italic;
  background:var(--gold-grad);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
}
.lead{color:var(--muted);font-size:1.02rem;max-width:54ch;margin-top:18px}

/* ---- Botões ---- */
.btn{
  display:inline-flex;align-items:center;gap:9px;
  font-family:var(--util);font-weight:400;font-size:.86rem;
  letter-spacing:.04em;
  padding:13px 22px;border-radius:999px;
  transition:transform .35s var(--ease),box-shadow .35s var(--ease),background .35s var(--ease),color .35s var(--ease);
  white-space:nowrap;
}
.btn svg{flex:none}
.btn-ico{width:17px;height:17px;flex:none;object-fit:contain}
.btn-gold .btn-ico{filter:brightness(0) saturate(100%) opacity(.78)}
.btn-gold{
  background:var(--gold-grad);color:#1a1305;font-weight:500;
  box-shadow:0 10px 30px -12px rgba(201,162,75,.65);
}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 16px 40px -12px rgba(201,162,75,.8)}
.btn-outline{
  border:1px solid var(--line);color:var(--ivory);
  background:rgba(255,255,255,.02);
}
.btn-outline:hover{border-color:var(--gold);color:var(--gold-soft);transform:translateY(-2px)}
.btn-wa{background:rgba(255,255,255,.03);border:1px solid var(--line-soft);color:var(--ivory)}
.btn-wa:hover{border-color:var(--gold);color:var(--gold-soft)}
.btn-block{width:100%;justify-content:center;padding:16px}

/* ---- Glass ---- */
.glass{
  background:var(--glass);
  border:1px solid var(--glass-brd);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  border-radius:var(--radius);
}

/* ============================================================
   HEADER
   ============================================================ */
.site-header{
  position:fixed;top:0;left:0;right:0;z-index:60;
  transition:background .4s var(--ease),border-color .4s var(--ease),backdrop-filter .4s;
  border-bottom:1px solid transparent;
}
.site-header.scrolled{
  background:rgba(11,11,13,.82);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line-soft);
}
.header-inner{display:flex;align-items:center;gap:24px;height:78px}
.brand{display:flex;align-items:center;gap:11px}
.brand-mark{display:inline-flex;filter:drop-shadow(0 2px 6px rgba(201,162,75,.25))}
.brand-word{font-family:var(--serif);font-size:1.95rem;font-weight:600;letter-spacing:.3px;line-height:1}
.bw-silver{color:var(--silver)}
.bw-gold{background:var(--gold-grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}

.nav{display:flex;gap:30px;margin-left:auto}
.nav a{
  font-family:var(--util);font-size:.9rem;color:var(--ivory);
  position:relative;padding:6px 0;transition:color .3s;
}
.nav a::after{content:"";position:absolute;left:0;bottom:0;width:0;height:1px;background:var(--gold-grad);transition:width .35s var(--ease)}
.nav a:hover{color:var(--gold-soft)}
.nav a:hover::after{width:100%}
.header-cta{margin-left:8px}

.nav-toggle{display:none;flex-direction:column;gap:5px;width:34px;height:34px;align-items:center;justify-content:center;margin-left:auto}
.nav-toggle span{width:22px;height:1.6px;background:var(--ivory);transition:transform .3s,opacity .3s}

/* ============================================================
   HERO
   ============================================================ */
.hero{position:relative;min-height:90vh;display:flex;align-items:center;padding-top:78px;overflow:hidden}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-slideshow{position:absolute;inset:0;z-index:0}
.hero-slide{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0;transition:opacity 1.6s ease-in-out}
.hero-slide.is-active{opacity:.5}
.hero-bg::after{
  content:"";position:absolute;inset:0;z-index:1;
  background:
    linear-gradient(90deg, rgba(8,8,10,.96) 0%, rgba(8,8,10,.82) 34%, rgba(8,8,10,.45) 62%, rgba(8,8,10,.35) 100%),
    linear-gradient(180deg, rgba(8,8,10,.55) 0%, transparent 28%, transparent 62%, var(--noir) 100%);
}

.hero-inner{position:relative;z-index:2;display:grid;grid-template-columns:1.25fr .75fr;gap:40px;align-items:center;width:100%}
.hero-copy{max-width:620px}
.hero-title{
  font-family:var(--serif);font-weight:500;
  font-size:clamp(3rem,8vw,6rem);line-height:.98;letter-spacing:-1px;
  margin:6px 0 22px;
}
.hero-sub{color:var(--muted);font-size:1.12rem;max-width:40ch;margin-bottom:34px}
.hero-actions{display:flex;flex-wrap:wrap;gap:14px}

.hero-badge{width:fit-content;max-width:300px;margin-left:auto}
.hero-badge img{display:block;width:100%;height:auto;border-radius:20px;border:1px solid var(--line);box-shadow:0 22px 55px -22px rgba(0,0,0,.7)}

.scroll-cue{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:2;width:24px;height:38px;border:1px solid var(--line);border-radius:14px;display:grid;place-items:start center;padding-top:7px}
.scroll-cue span{width:3px;height:7px;border-radius:3px;background:var(--gold);animation:cue 1.8s var(--ease) infinite}
@keyframes cue{0%{opacity:0;transform:translateY(-3px)}40%{opacity:1}100%{opacity:0;transform:translateY(9px)}}

/* ============================================================
   SOBRE
   ============================================================ */
.sobre{background:linear-gradient(180deg,var(--noir) 0%,var(--noir-2) 100%)}
.sobre-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(34px,5vw,72px);align-items:center}
.sobre-photo{position:relative}
.sobre-photo img{border-radius:var(--radius);width:100%;aspect-ratio:4/4.2;object-fit:cover;border:1px solid var(--line-soft)}
.sobre-photo::before{content:"";position:absolute;inset:-14px;border:1px solid var(--line);border-radius:calc(var(--radius) + 8px);z-index:-1;transform:translate(14px,14px)}
.sobre-badge{position:absolute;left:-18px;bottom:26px;padding:14px 20px;display:flex;flex-direction:column;gap:2px}
.sobre-badge strong{font-family:var(--util);letter-spacing:.18em;color:var(--gold-soft);font-size:.86rem}
.sobre-badge small{color:var(--muted);font-size:.74rem}

.pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin:34px 0 30px}
.pillar{text-align:left}
.pillar-ico{display:inline-grid;place-items:center;width:52px;height:52px;border-radius:12px;color:var(--gold);background:rgba(201,162,75,.08);border:1px solid var(--line);margin-bottom:12px}
.pillar-ico img{width:30px;height:30px;object-fit:contain}
.pillar p{font-size:.82rem;color:var(--muted);line-height:1.4}

/* ============================================================
   IMÓVEIS
   ============================================================ */
.imoveis{background:var(--noir-2)}
.imoveis-head{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap;margin-bottom:40px}
.filters{display:flex;flex-wrap:wrap;gap:10px}
.chip{
  font-family:var(--util);font-size:.84rem;
  padding:9px 18px;border-radius:999px;
  border:1px solid var(--line-soft);color:var(--muted);
  transition:all .3s var(--ease);
}
.chip:hover{color:var(--ivory);border-color:var(--line)}
.chip.is-active{background:var(--gold-grad);color:#1a1305;font-weight:500;border-color:transparent}

.cards-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.prop-card{
  background:var(--card);border:1px solid var(--line-soft);
  border-radius:var(--radius);overflow:hidden;
  transition:transform .4s var(--ease),border-color .4s var(--ease),box-shadow .4s var(--ease);
  display:flex;flex-direction:column;
}
.prop-card:hover{transform:translateY(-6px);border-color:var(--line);box-shadow:0 24px 50px -24px rgba(0,0,0,.8)}
.prop-media{position:relative;aspect-ratio:4/3;overflow:hidden}
.prop-media .ph{position:absolute;inset:0;display:grid;place-items:center}
.prop-media .ph svg{width:62%;opacity:.5}
.prop-media .prop-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1}
.prop-media .ph-label{position:absolute;bottom:14px;left:16px;font-family:var(--serif);font-style:italic;font-size:1.05rem;color:rgba(244,241,234,.85);z-index:1}
.badge{position:absolute;top:12px;z-index:3;padding:5px 11px;border-radius:999px;font-family:var(--util);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase}
.badge-type{left:12px;background:rgba(11,11,13,.7);color:var(--gold-soft);border:1px solid var(--line);backdrop-filter:blur(6px)}
.badge-status{right:12px;background:rgba(201,162,75,.16);color:var(--gold-soft);border:1px solid var(--line)}
.fav{position:absolute;bottom:12px;right:12px;z-index:3;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:rgba(11,11,13,.6);border:1px solid var(--line-soft);color:var(--ivory);transition:all .3s}
.fav:hover,.fav.on{color:var(--gold);border-color:var(--gold)}

.prop-body{padding:18px;display:flex;flex-direction:column;gap:10px;flex:1}
.prop-title{font-family:var(--serif);font-size:1.25rem;font-weight:600;color:var(--ivory);line-height:1.15}
.prop-loc{font-size:.82rem;color:var(--muted);display:flex;align-items:center;gap:6px}
.prop-loc svg{color:var(--gold);flex:none}
.prop-specs{display:flex;gap:16px;font-size:.78rem;color:var(--muted);padding-top:4px;border-top:1px solid var(--line-soft);margin-top:2px}
.prop-specs span{display:flex;align-items:center;gap:5px}
.prop-specs svg{color:var(--gold-deep)}
.prop-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:12px}
.prop-price small{display:block;font-size:.66rem;color:var(--muted-2);text-transform:uppercase;letter-spacing:.08em;font-family:var(--util)}
.prop-price strong{font-family:var(--serif);font-size:1.2rem;color:var(--gold-soft);font-weight:600}
.prop-card .btn{padding:10px 16px;font-size:.78rem}

.empty-state{text-align:center;color:var(--muted);padding:50px 0;font-size:1rem}
.empty-state a{color:var(--gold-soft);text-decoration:underline}
.imoveis-foot{display:flex;justify-content:center;margin-top:44px}

/* ============================================================
   SERVIÇOS
   ============================================================ */
.servicos{background:linear-gradient(180deg,var(--noir-2),var(--noir))}
.servicos-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(34px,6vw,80px);align-items:center}
.servicos-list{display:grid;grid-template-columns:repeat(3,1fr);gap:30px 24px}
.servicos-list li{font-family:var(--util);font-size:.86rem;color:var(--muted);text-align:center;line-height:1.4}
.svc-ico{display:grid;place-items:center;width:64px;height:64px;margin:0 auto 14px;border-radius:14px;color:var(--gold);background:rgba(201,162,75,.07);border:1px solid var(--line);transition:all .35s var(--ease)}
.svc-ico img{width:36px;height:36px;object-fit:contain}
.servicos-list li:hover .svc-ico{border-color:var(--gold);background:rgba(201,162,75,.14);transform:translateY(-4px)}

/* ============================================================
   POR QUE ESCOLHER
   ============================================================ */
.porque{background:var(--noir)}
.porque-head{text-align:center;margin-bottom:48px}
.porque-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.porque-card{padding:30px 24px;transition:transform .4s var(--ease),border-color .4s}
.porque-card:hover{transform:translateY(-6px);border-color:var(--line)}
.check{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--gold-grad);color:#1a1305;font-weight:600;margin-bottom:16px}
.porque-card h3{font-family:var(--serif);font-size:1.3rem;font-weight:600;margin-bottom:8px;color:var(--ivory)}
.porque-card p{font-size:.88rem;color:var(--muted)}

/* ============================================================
   DEPOIMENTOS
   ============================================================ */
.depo{background:linear-gradient(180deg,var(--noir),var(--noir-2))}
.depo-head{text-align:center;margin-bottom:42px}
.depo-carousel{position:relative;display:flex;align-items:stretch;gap:16px}
.depo-viewport{overflow:hidden;flex:1}
.depo-track{display:flex;gap:24px;transition:transform .55s cubic-bezier(.22,.61,.36,1);will-change:transform}
.depo-card{flex:0 0 calc(50% - 12px);background:var(--card);border:1px solid var(--line-soft);border-radius:var(--radius);padding:30px;display:flex;flex-direction:column}
.stars{color:var(--gold);letter-spacing:3px;margin-bottom:14px}
.depo-text{font-family:var(--serif);font-style:italic;font-size:1.12rem;line-height:1.5;color:var(--ivory);margin-bottom:20px}
.depo-author{display:flex;align-items:center;gap:12px;margin-top:auto}
.depo-avatar{width:44px;height:44px;border-radius:50%;background:var(--gold-grad);display:grid;place-items:center;font-family:var(--serif);font-weight:600;color:#1a1305}
.depo-author strong{display:block;font-size:.92rem;font-weight:500}
.depo-author small{color:var(--muted);font-size:.78rem}
.carousel-btn{width:46px;height:46px;flex:none;align-self:center;border-radius:50%;border:1px solid var(--line);color:var(--gold-soft);font-size:1.5rem;display:grid;place-items:center;transition:all .3s}
.carousel-btn:hover{background:var(--gold-grad);color:#1a1305;border-color:transparent}
.depo-dots{display:flex;justify-content:center;gap:8px;margin-top:26px}
.depo-dots button{width:8px;height:8px;border-radius:50%;background:var(--line-soft);transition:all .3s}
.depo-dots button.on{background:var(--gold);width:22px;border-radius:5px}

/* ============================================================
   INSTAGRAM
   ============================================================ */
.insta{background:var(--noir-2)}
.insta-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:36px}
.insta-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
.insta-tile{position:relative;aspect-ratio:1;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--line-soft);display:grid;place-items:center;background:linear-gradient(150deg,#1c1c20,#0c0c0e);transition:transform .4s var(--ease),border-color .4s}
.insta-tile:hover{transform:scale(1.03);border-color:var(--gold)}
.insta-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.insta-tile .ig-cap{position:absolute;inset:0;z-index:2;display:flex;align-items:flex-end;padding:13px;font-family:var(--serif);font-style:italic;font-size:.88rem;color:rgba(244,241,234,.95);background:linear-gradient(to top,rgba(11,11,13,.82),rgba(11,11,13,.15) 55%,transparent 80%)}
.insta-tile .ig-hover{position:absolute;top:10px;right:10px;z-index:2;color:#fff;opacity:.9;filter:drop-shadow(0 1px 3px rgba(0,0,0,.6));transition:transform .35s}
.insta-tile:hover .ig-hover{transform:scale(1.12)}

/* ============================================================
   BLOG
   ============================================================ */
.blog{background:linear-gradient(180deg,var(--noir-2),var(--noir))}
.blog-head{text-align:center;margin-bottom:44px}
.blog-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.blog-card{background:var(--card);border:1px solid var(--line-soft);border-radius:var(--radius);overflow:hidden;transition:transform .4s var(--ease),border-color .4s;display:flex;flex-direction:column}
.blog-card:hover{transform:translateY(-6px);border-color:var(--line)}
.blog-media{aspect-ratio:16/10;position:relative;display:grid;place-items:center;overflow:hidden}
.blog-media svg{width:46%;opacity:.4}
.blog-tag{position:absolute;top:12px;left:12px;font-family:var(--util);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--gold-soft);background:rgba(11,11,13,.65);border:1px solid var(--line);padding:4px 10px;border-radius:999px}
.blog-body{padding:20px;display:flex;flex-direction:column;gap:10px;flex:1}
.blog-body h3{font-family:var(--serif);font-size:1.22rem;font-weight:600;line-height:1.2;color:var(--ivory)}
.blog-body p{font-size:.84rem;color:var(--muted);flex:1}
.blog-read{font-family:var(--util);font-size:.8rem;color:var(--gold-soft);display:flex;align-items:center;gap:6px}

/* ============================================================
   CONTATO
   ============================================================ */
.contato{background:var(--noir)}
.contato-head{text-align:center;margin-bottom:48px}
.contato-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:36px;align-items:stretch}
.contato-info{display:flex;flex-direction:column;gap:14px}
.contact-line{display:flex;align-items:center;gap:14px;padding:16px 20px;border:1px solid var(--line-soft);border-radius:var(--radius-sm);transition:all .3s;font-size:.95rem}
.contact-line:hover{border-color:var(--gold);color:var(--gold-soft)}
.ci-ico{width:40px;height:40px;flex:none;border-radius:10px;display:grid;place-items:center;color:var(--gold);background:rgba(201,162,75,.08);border:1px solid var(--line)}
.contato-map{margin-top:4px;flex:1;min-height:230px;border-radius:var(--radius);overflow:hidden;border:1px solid var(--line-soft)}
.contato-map iframe{width:100%;height:100%;min-height:230px;border:0;filter:grayscale(1) invert(.92) contrast(.85) hue-rotate(180deg);opacity:.85}

.contato-form{padding:30px;display:flex;flex-direction:column;gap:16px}
.contato-form .row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.field{display:flex;flex-direction:column;gap:7px}
.field span{font-family:var(--util);font-size:.76rem;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}
.field input,.field textarea{
  background:rgba(255,255,255,.03);border:1px solid var(--line-soft);
  border-radius:12px;padding:13px 15px;color:var(--ivory);font-family:var(--sans);font-size:.95rem;
  transition:border-color .3s,background .3s;resize:vertical;
}
.field input::placeholder,.field textarea::placeholder{color:var(--muted-2)}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--gold);background:rgba(201,162,75,.05)}
.form-note{font-size:.85rem;text-align:center;color:var(--gold-soft)}

/* ============================================================
   FOOTER
   ============================================================ */
.site-footer{background:var(--noir-2);border-top:1px solid var(--line-soft);padding-top:64px}
.footer-top{display:grid;grid-template-columns:1.4fr .7fr .7fr 1.3fr;gap:34px;padding-bottom:44px;border-bottom:1px solid var(--line-soft)}
.footer-word{font-size:1.7rem;display:inline-block;margin-bottom:14px}
.footer-brand p{color:var(--muted);font-size:.88rem;max-width:34ch}
.socials{display:flex;gap:12px;margin-top:20px}
.socials a{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;color:var(--ivory);border:1px solid var(--line-soft);transition:all .3s}
.socials a:hover{color:var(--gold);border-color:var(--gold);transform:translateY(-3px)}
.footer-col h4{font-family:var(--util);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-soft);margin-bottom:18px}
.footer-col a{display:block;color:var(--muted);font-size:.88rem;padding:5px 0;transition:color .3s}
.footer-col a:hover{color:var(--ivory)}

.creci-card{border:1px solid var(--line);border-radius:var(--radius-sm);padding:18px;background:rgba(255,255,255,.02)}
.creci-tag{display:inline-block;font-family:var(--util);font-size:.7rem;letter-spacing:.14em;color:#c0392b;border:1px solid rgba(192,57,43,.45);background:rgba(192,57,43,.08);padding:3px 10px;border-radius:6px;margin-bottom:12px}
.creci-name{font-family:var(--serif);font-size:1.05rem;font-weight:600;color:var(--ivory);margin-bottom:12px}
.creci-list{display:flex;flex-direction:column;gap:9px;margin-bottom:12px}
.creci-list div{display:flex;flex-direction:column}
.creci-list dt{font-family:var(--util);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted-2)}
.creci-list dd{font-size:.82rem;color:var(--ivory)}
.creci-link{font-size:.8rem;color:var(--gold-soft);text-decoration:underline;word-break:break-all}
.creci-note{font-size:.72rem;color:var(--muted-2);line-height:1.45;margin-top:12px;font-style:italic}

.footer-bottom{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:24px 24px 30px}
.footer-bottom p{font-size:.8rem;color:var(--muted-2)}

/* ============================================================
   WHATSAPP FLUTUANTE
   ============================================================ */
.wa-float{
  position:fixed;right:22px;bottom:22px;z-index:70;
  width:60px;height:60px;border-radius:50%;
  background:linear-gradient(145deg,#25d366,#128c4f);color:#fff;
  display:grid;place-items:center;
  box-shadow:0 14px 34px -8px rgba(37,211,102,.55);
  transition:transform .35s var(--ease);
  animation:wa-pulse 2.8s ease-in-out infinite;
}
.wa-float:hover{transform:scale(1.08)}
@keyframes wa-pulse{0%,100%{box-shadow:0 14px 34px -8px rgba(37,211,102,.55)}50%{box-shadow:0 14px 44px -4px rgba(37,211,102,.8)}}

/* ============================================================
   REVEAL ON SCROLL
   ============================================================ */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.reveal.in{opacity:1;transform:none}

/* ============================================================
   RESPONSIVO
   ============================================================ */
@media (max-width:1024px){
  .cards-grid,.blog-grid{grid-template-columns:repeat(2,1fr)}
  .insta-grid{grid-template-columns:repeat(3,1fr)}
  .porque-grid{grid-template-columns:repeat(2,1fr)}
  .hero-inner{grid-template-columns:1fr}
  .hero-badge{margin:8px 0 0;max-width:240px}
  .sobre-grid,.servicos-grid,.contato-grid{grid-template-columns:1fr}
  .sobre-photo{max-width:420px}
  .footer-top{grid-template-columns:1fr 1fr}
}
@media (max-width:760px){
  .nav,.header-cta{display:none}
  .nav-toggle{display:flex}
  .nav.open{
    display:flex;flex-direction:column;position:absolute;top:78px;left:0;right:0;
    background:rgba(11,11,13,.96);backdrop-filter:blur(16px);
    padding:22px 24px;gap:6px;border-bottom:1px solid var(--line-soft);margin:0;
  }
  .nav.open a{padding:12px 0;border-bottom:1px solid var(--line-soft)}
  .cards-grid,.blog-grid,.pillars,.servicos-list{grid-template-columns:1fr}
  .pillars{grid-template-columns:repeat(2,1fr)}
  .servicos-list{grid-template-columns:repeat(2,1fr)}
  .insta-grid{grid-template-columns:repeat(2,1fr)}
  .porque-grid{grid-template-columns:1fr}
  .depo-card{flex:0 0 100%}
  .contato-form .row{grid-template-columns:1fr}
  .footer-top{grid-template-columns:1fr}
}

/* Acessibilidade — reduzir movimento */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .reveal{opacity:1;transform:none}
}

/* Foco visível */
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{
  outline:2px solid var(--gold);outline-offset:3px;border-radius:6px;
}
